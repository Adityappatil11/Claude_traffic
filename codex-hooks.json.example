{
  "hooks": {
    "SessionStart": [
      {
        "command": "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py SessionStart",
        "timeoutSec": 2
      }
    ],
    "PreToolUse": [
      {
        "command": "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py PreToolUse",
        "timeoutSec": 2
      }
    ],
    "PostToolUse": [
      {
        "command": "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py PostToolUse",
        "timeoutSec": 2
      }
    ],
    "Interrupt": [
      {
        "command": "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py Interrupt",
        "timeoutSec": 2
      }
    ],
    "SessionEnd": [
      {
        "command": "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py SessionEnd",
        "timeoutSec": 2
      }
    ]
  }
}
