{
  "theme": "light",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py",
              "UserPromptSubmit"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py",
              "PermissionRequest"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py",
              "Notification"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py",
              "PreToolUse"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py",
              "PostToolUse"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "/media/aditya/STUDY/projects/Claude_traffic/hw_light.py",
              "Stop"
            ]
          }
        ]
      }
    ]
  }
}
