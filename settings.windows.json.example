{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "UserPromptSubmit"
            ]
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "PermissionRequest"
            ]
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "Notification"
            ]
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "SessionStart"
            ]
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "SessionEnd"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "SubagentStart"
            ]
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "SubagentStop"
            ]
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "PreCompact"
            ]
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "PostCompact"
            ]
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "PreToolUse"
            ]
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "PostToolUse"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py",
            "args": [
              "-3",
              "E:\\projects\\Claude_traffic\\hw_light.py",
              "Stop"
            ]
          }
        ]
      }
    ]
  }
}
